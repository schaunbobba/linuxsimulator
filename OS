          officeDrawContext.beginPath();
          officeDrawContext.moveTo(drawStartPoint.x, drawStartPoint.y);
          officeDrawContext.lineTo(point.x, point.y);
          officeDrawContext.stroke();
        };
        image.src = linePreview;
      } else {
        officeDrawContext.lineTo(point.x, point.y);
        officeDrawContext.stroke();
      }
