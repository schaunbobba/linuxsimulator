  <script>
    const menuItems = document.querySelectorAll('.menu-item');
    const submenuLinks = document.querySelectorAll('[data-open]');
    const dockButtons = document.querySelectorAll('.dock-item');
    const desktopIcons = document.querySelectorAll('.icon');
    const windows = document.querySelectorAll('.window');

    const codeEditor = document.getElementById('code-editor-textarea');
    const codeEditorFrame = document.getElementById('code-editor-frame');
    const codeEditorWorkspace = document.getElementById('code-editor-workspace');
    const codeEditorStatus = document.getElementById('code-editor-status');
    const codeEditorStorageKey = 'linuxStudioCodeHtml';
    let codeEditorUpdateTimer;

    try {
      const savedCode = localStorage.getItem(codeEditorStorageKey);
      if (savedCode !== null) codeEditor.value = savedCode;
    } catch (error) {
      codeEditorStatus.textContent = 'Lokale opslag is niet beschikbaar.';
    }

    const updateCodePreview = () => {
      codeEditorFrame.srcdoc = codeEditor.value;
      codeEditorStatus.textContent = 'Preview bijgewerkt';
    };

    updateCodePreview();
    codeEditor.addEventListener('input', () => {
      codeEditorStatus.textContent = 'Niet opgeslagen';
      clearTimeout(codeEditorUpdateTimer);
      codeEditorUpdateTimer = setTimeout(updateCodePreview, 250);
    });

    document.querySelectorAll('[data-code-view]').forEach(button => {
      button.addEventListener('click', () => {
        codeEditorWorkspace.dataset.view = button.dataset.codeView;
        document.querySelectorAll('[data-code-view]').forEach(viewButton => {
          viewButton.setAttribute('aria-pressed', String(viewButton === button));
        });
      });
    });

    document.getElementById('code-editor-run').addEventListener('click', updateCodePreview);
    document.getElementById('code-editor-save').addEventListener('click', () => {
      try {
        localStorage.setItem(codeEditorStorageKey, codeEditor.value);
        codeEditorStatus.textContent = 'Opgeslagen in deze browser';
      } catch (error) {
        codeEditorStatus.textContent = 'Opslaan is niet gelukt';
      }
    });
    document.getElementById('code-editor-open').addEventListener('click', () => {
      document.getElementById('code-editor-file').click();
    });
    document.getElementById('code-editor-file').addEventListener('change', event => {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.addEventListener('load', () => {
        codeEditor.value = String(reader.result || '');
        updateCodePreview();
        codeEditorStatus.textContent = `${file.name} geopend`;
      });
      reader.readAsText(file);
      event.target.value = '';
    });
    document.getElementById('code-editor-download').addEventListener('click', () => {
      const file = new Blob([codeEditor.value], { type: 'text/html;charset=utf-8' });
      const downloadUrl = URL.createObjectURL(file);
      const link = document.createElement('a');
      link.href = downloadUrl;
      link.download = 'index.html';
      link.click();
      URL.revokeObjectURL(downloadUrl);
      codeEditorStatus.textContent = 'index.html gedownload';
    });
    codeEditor.addEventListener('keydown', event => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 's') {
        event.preventDefault();
        document.getElementById('code-editor-save').click();
      }
      if (event.key === 'Tab') {
        event.preventDefault();
        const start = codeEditor.selectionStart;
        const end = codeEditor.selectionEnd;
        codeEditor.setRangeText('  ', start, end, 'end');
        codeEditor.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });

    const fileExplorerState = {
      current: 'home',
      history: []
    };

    const fileExplorerData = {
      home: {
        label: 'Home',
        path: '/home',
        items: [
          { name: 'Documents', type: 'folder', target: 'documents' },
          { name: 'Downloads', type: 'folder', target: 'downloads' },
          { name: 'Pictures', type: 'folder', target: 'pictures' },
          { name: "Video's", type: 'folder', target: 'videos' },
          { name: 'Projects', type: 'folder', target: 'projects' }
        ]
      },
      documents: {
        label: 'Documents',
        path: '/home/Documents',
        items: [
          { name: 'Resume.pdf', type: 'file', meta: '1 file' },
          { name: 'Notes.txt', type: 'file', meta: '2 files' },
          { name: 'Projects', type: 'folder', target: 'projects', meta: '4 folders' },
          { name: 'Archive', type: 'folder', target: 'archive', meta: '3 items' }
        ]
      },
      downloads: {
        label: 'Downloads',
        path: '/home/Downloads',
        items: [
          { name: 'setup.zip', type: 'file', meta: '1 file' },
          { name: 'notes.pdf', type: 'file', meta: '2 files' },
          { name: 'images', type: 'folder', target: 'pictures', meta: '3 folders' }
        ]
      },
      pictures: {
        label: 'Pictures',
        path: '/home/Pictures',
        items: [
          { name: 'Landscape.jpg', type: 'file', meta: '1 file' },
          { name: 'Portrait.png', type: 'file', meta: '1 file' },
          { name: 'Wallpaper', type: 'folder', target: 'projects', meta: '2 folders' }
        ]
      },
      projects: {
        label: 'Projects',
        path: '/home/Projects',
        items: [
          { name: 'Website', type: 'folder', target: 'documents', meta: '2 files' },
          { name: 'Linux Setup', type: 'folder', target: 'downloads', meta: '4 files' },
          { name: 'Portfolio', type: 'folder', target: 'pictures', meta: '3 folders' }
        ]
       },
      videos: {
        label: 'Videos',
        path: '/home/Videos',
        items: [
          { name: 'Welkom bij Linux.mp4', type: 'video', meta: '128 MB' },
          { name: 'Desktop rondleiding.webm', type: 'video', meta: '84 MB' },
          { name: 'Project presentatie.mp4', type: 'video', meta: '216 MB' },
          { name: 'Linux tips en trucs.mp4', type: 'video', meta: '156 MB' }
        ]
      },
      archive: {
        label: 'Archive',
        path: '/home/Documents/Archive',
        items: [
          { name: 'backup.tar', type: 'file', meta: '1 file' },
          { name: 'logs', type: 'folder', target: 'home', meta: '2 folders' }
        ]
      }
    };

    // Legacy key, only used once to migrate old saves into the unified filesystem store.
    const officeStorageKey = 'linux-simulator-office-documents';
    const FILESYSTEM_STORAGE_KEY = 'linux-simulator-filesystem';

    function loadFileSystemState() {
      try {
        const saved = JSON.parse(localStorage.getItem(FILESYSTEM_STORAGE_KEY) || 'null');
        if (saved && typeof saved === 'object') {
          Object.keys(saved).forEach(key => {
            const entry = saved[key];
            if (entry && Array.isArray(entry.items)) {
              fileExplorerData[key] = {
                label: entry.label || key,
                path: entry.path || `/home/${key}`,
                items: entry.items
              };
            }
          });
          return;
        }
      } catch {
        localStorage.removeItem(FILESYSTEM_STORAGE_KEY);
      }

      // Migrate documents saved under the old office-only storage key.
      try {
        const legacyDocuments = JSON.parse(localStorage.getItem(officeStorageKey) || '[]');
        if (Array.isArray(legacyDocuments)) {
          legacyDocuments.forEach(documentFile => {
            if (
              documentFile &&
              documentFile.type === 'office' &&
              typeof documentFile.name === 'string' &&
              typeof documentFile.app === 'string' &&
              typeof documentFile.content === 'string'
            ) {
              fileExplorerData.documents.items.push(documentFile);
            }
          });
        }
      } catch {
        // negeer corrupte legacy data
      }
      localStorage.removeItem(officeStorageKey);
      persistFileSystemState();
    }

    function persistFileSystemState() {
      localStorage.setItem(FILESYSTEM_STORAGE_KEY, JSON.stringify(fileExplorerData));
    }

    loadFileSystemState();

    function renderFilesExplorer() {
      const browser = document.querySelector('#window-files .file-browser');
      persistFileSystemState();
      if (!browser) return;

      const currentPage = fileExplorerData[fileExplorerState.current] || fileExplorerData.home;
      const folderGrid = browser.querySelector('.folder-grid');
      const breadcrumb = browser.querySelector('.file-breadcrumb');
      const backBtn = browser.querySelector('.file-back');
      const homeBtn = browser.querySelector('.file-home');

      breadcrumb.textContent = currentPage.path;
      backBtn.disabled = fileExplorerState.history.length === 0;
      backBtn.style.opacity = fileExplorerState.history.length === 0 ? '0.5' : '1';

      folderGrid.innerHTML = currentPage.items.map(item => {
        const typeIcon = item.type === 'folder' ? '📁' : item.type === 'video' ? '🎬' : item.type === 'office' ? '📝' : '📄';
        const meta = item.meta ? '<small>' + item.meta + '</small>' : '';
        const target = item.target || item.name;
        return '<div class="folder-item" data-target="' + target + '" data-type="' + item.type + '"><span class="glyph">' + typeIcon + '</span>' + escapeHtml(item.name) + meta + '</div>';
      }).join('');

      folderGrid.querySelectorAll('.folder-item').forEach(item => {
        item.addEventListener('click', () => {
          folderGrid.querySelectorAll('.folder-item').forEach(folderItem => {
            folderItem.classList.toggle('selected', folderItem === item);
          });
        });

        item.addEventListener('dblclick', () => {
          const target = item.dataset.target;
          const itemType = item.dataset.type;
          if (itemType === 'folder' && fileExplorerData[target]) {
            fileExplorerState.history.push(fileExplorerState.current);
            fileExplorerState.current = target;
