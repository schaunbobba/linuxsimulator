    const windowLayer = document.querySelector('.window-layer');
    let activeWindowDrag = null;
    let activeWindowResize = null;

    function getWindowResizeEdges(windowEl, clientX, clientY) {
      const resizeBorder = 8;
      const rect = windowEl.getBoundingClientRect();
      return {
        left: clientX - rect.left <= resizeBorder,
        right: rect.right - clientX <= resizeBorder,
        top: clientY - rect.top <= resizeBorder,
        bottom: rect.bottom - clientY <= resizeBorder
      };
    }

    function getResizeCursor(edges) {
      if ((edges.left && edges.top) || (edges.right && edges.bottom)) return 'nwse-resize';
      if ((edges.right && edges.top) || (edges.left && edges.bottom)) return 'nesw-resize';
      if (edges.left || edges.right) return 'ew-resize';
      if (edges.top || edges.bottom) return 'ns-resize';
      return '';
    }

    document.addEventListener('mousedown', (event) => {
      if (event.button !== 0) return;

      const windowAtPointer = event.target.closest('.window');
      if (windowAtPointer && !windowAtPointer.classList.contains('maximized')) {
        const edges = getWindowResizeEdges(windowAtPointer, event.clientX, event.clientY);
        if (getResizeCursor(edges)) {
          const rect = windowAtPointer.getBoundingClientRect();
          const layerRect = windowLayer.getBoundingClientRect();
          activeWindowResize = {
            windowEl: windowAtPointer,
            edges,
            left: rect.left - layerRect.left,
            top: rect.top - layerRect.top,
            width: rect.width,
            height: rect.height,
            startX: event.clientX,
            startY: event.clientY
          };
          bringToFront(windowAtPointer);
          event.preventDefault();
          return;
        }
      }

      const elementsAtPointer = document.elementsFromPoint(event.clientX, event.clientY);
      if (elementsAtPointer.some(element => element.classList.contains('window-btn'))) return;

      const titlebar = elementsAtPointer.find(element => element.classList.contains('titlebar'));
      const windowEl = titlebar && titlebar.closest('.window');
      if (!windowEl || windowEl.classList.contains('maximized')) return;

      const windowRect = windowEl.getBoundingClientRect();
      activeWindowDrag = {
        windowEl,
        offsetX: event.clientX - windowRect.left,
        offsetY: event.clientY - windowRect.top
      };
      bringToFront(windowEl);
      event.preventDefault();
    });

    document.addEventListener('mousemove', (event) => {
      if (activeWindowResize) {
        const { windowEl, edges, left, top, width, height, startX, startY } = activeWindowResize;
        const layerRect = windowLayer.getBoundingClientRect();
        const minWidth = 280;
        const minHeight = 160;
        let nextLeft = left;
        let nextTop = top;
        let nextWidth = width;
        let nextHeight = height;
        const deltaX = event.clientX - startX;
        const deltaY = event.clientY - startY;

        if (edges.left) {
          nextWidth = Math.max(minWidth, width - deltaX);
          nextLeft = left + (width - nextWidth);
        }
        if (edges.right) nextWidth = Math.max(minWidth, Math.min(width + deltaX, layerRect.width - left - 10));
        if (edges.top) {
          nextHeight = Math.max(minHeight, height - deltaY);
          nextTop = top + (height - nextHeight);
        }
        if (edges.bottom) nextHeight = Math.max(minHeight, Math.min(height + deltaY, layerRect.height - top - 10));

        windowEl.style.left = `${Math.max(10, nextLeft)}px`;
        windowEl.style.top = `${Math.max(10, nextTop)}px`;
        windowEl.style.width = `${nextWidth}px`;
        windowEl.style.height = `${nextHeight}px`;
        return;
      }
      if (!activeWindowDrag) return;

      const { windowEl, offsetX, offsetY } = activeWindowDrag;
      const layerRect = windowLayer.getBoundingClientRect();
      const maxLeft = Math.max(10, layerRect.width - windowEl.offsetWidth - 10);
      const maxTop = Math.max(10, layerRect.height - windowEl.offsetHeight - 10);
      const left = event.clientX - layerRect.left - offsetX;
      const top = event.clientY - layerRect.top - offsetY;

      windowEl.style.left = `${Math.min(Math.max(10, left), maxLeft)}px`;
      windowEl.style.top = `${Math.min(Math.max(10, top), maxTop)}px`;
    });

    document.addEventListener('mouseup', () => {
      activeWindowDrag = null;
      activeWindowResize = null;
    });

    document.addEventListener('mousemove', (event) => {
      if (activeWindowResize || activeWindowDrag) return;
      const windowAtPointer = event.target.closest('.window');
      const cursor = windowAtPointer && !windowAtPointer.classList.contains('maximized')
        ? getResizeCursor(getWindowResizeEdges(windowAtPointer, event.clientX, event.clientY))
        : '';
      document.body.style.cursor = cursor;
    });

