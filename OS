    const serverStorageKey = 'linux-simulator-server-pages';
    const serverDbName = 'linux-simulator-db';
    const serverStoreName = 'server-pages';
    const serverState = {
      pages: []
    };
    let serverDbPromise = null;

    function isExternalPageUrl(value) {
      try {
        const url = new URL(value);
        return url.protocol === 'https:' && url.hostname !== 'localhost' && !url.hostname.endsWith('.local');
      } catch {
        return false;
      }
    }

    function isValidServerPage(page) {
      return page && typeof page.name === 'string' && (
        (typeof page.url === 'string' && isExternalPageUrl(page.url)) ||
        (typeof page.html === 'string' && page.html.trim())
      );
    }

    // IndexedDB has a much larger quota than localStorage, so pages saved here aren't capped at a handful of entries.
    function openServerDb() {
      if (serverDbPromise) return serverDbPromise;
      serverDbPromise = new Promise((resolve, reject) => {
        const request = indexedDB.open(serverDbName, 1);
        request.onupgradeneeded = () => {
          const db = request.result;
          if (!db.objectStoreNames.contains(serverStoreName)) {
            db.createObjectStore(serverStoreName, { keyPath: 'id', autoIncrement: true });
          }
        };
        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error);
      });
      return serverDbPromise;
    }

    function dbGetAllPages() {
      return openServerDb().then(db => new Promise((resolve, reject) => {
        const tx = db.transaction(serverStoreName, 'readonly');
        const request = tx.objectStore(serverStoreName).getAll();
        request.onsuccess = () => resolve(request.result || []);
        request.onerror = () => reject(request.error);
      }));
    }

    function dbAddPage(page) {
      return openServerDb().then(db => new Promise((resolve, reject) => {
        const tx = db.transaction(serverStoreName, 'readwrite');
        const request = tx.objectStore(serverStoreName).add(page);
        request.onsuccess = () => resolve({ ...page, id: request.result });
        request.onerror = () => reject(request.error);
      }));
    }

    function dbDeletePage(id) {
      return openServerDb().then(db => new Promise((resolve, reject) => {
        const tx = db.transaction(serverStoreName, 'readwrite');
        const request = tx.objectStore(serverStoreName).delete(id);
        request.onsuccess = () => resolve();
        request.onerror = () => reject(request.error);
      }));
    }

    async function migrateLegacyServerPages() {
      let legacyPages = [];
      try {
        legacyPages = JSON.parse(localStorage.getItem(serverStorageKey) || '[]');
      } catch {
        legacyPages = [];
      }
      if (!Array.isArray(legacyPages) || !legacyPages.length) return;

      for (const page of legacyPages.filter(isValidServerPage)) {
        await dbAddPage(page).catch(() => {});
      }
      localStorage.removeItem(serverStorageKey);
    }

    async function loadServerPages() {
      try {
        await migrateLegacyServerPages();
        serverState.pages = (await dbGetAllPages()).filter(isValidServerPage);
      } catch {
        serverState.pages = [];
      }
      renderServerPages();
    }

    function renderServerPages() {
      const pageList = document.getElementById('server-page-list');
      const emptyMessage = document.getElementById('server-empty');
      if (!pageList || !emptyMessage) return;

      emptyMessage.hidden = serverState.pages.length > 0;
