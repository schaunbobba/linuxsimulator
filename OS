<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>index</title>
  <style>
    :root {
      --red-900: #0026ff04;
      --red-700: #fcfbfb00;
      --red-600: #ffffff00;
      --black-900: #111111;
      --black-800: #1d1d1d;
      --black-700: #2b2b2b;
      --gray-200: #000000;
      --gray-100: #f2f2f2;
      --blue-500: #4ca3ff;
      --shadow: rgba(0, 0, 0, 0.35);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: "Segoe UI", sans-serif;
      color: #fff;
      background: var(--black-700) url('https://upload.wikimedia.org/wikipedia/commons/6/6b/Red_Hat_logo_%282019%29.svg') center/260px no-repeat;
      background-blend-mode: multiply;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background: linear-gradient(rgba(0,0,0,.18), rgba(0,0,0,.28));
      pointer-events: none;
    }

    .topbar {
      position: relative;
      z-index: 20;
      height: 42px;
      background: linear-gradient(180deg, var(--red-700), var(--red-600));
      display: flex;
      align-items: center;
      padding: 0 16px;
      font-weight: 700;
      letter-spacing: 0.4px;
      box-shadow: 0 2px 6px var(--shadow);
      user-select: none;
    }

    .topbar .brand {
      white-space: nowrap;
    }

    .menu {
      display: flex;
      gap: 18px;
      margin-left: 24px;
      position: relative;
    }

    .menu-item {
      position: relative;
      padding: 9px 8px;
      cursor: pointer;
      border-radius: 4px;
      font-size: 14px;
      transition: background 0.15s ease;
    }

    .menu-item:hover,
    .menu-item.active {
      background: rgba(255,255,255,0.12);
    }

    .submenu {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      min-width: 180px;
      background: rgba(22,22,22,0.94);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 8px;
      box-shadow: 0 10px 24px rgba(0,0,0,0.35);
      display: none;
      overflow: hidden;
    }

    .menu-item.open + .submenu,
    .submenu.visible {
      display: block;
    }

    .submenu a {
      display: block;
      padding: 10px 14px;
      color: var(--gray-100);
      text-decoration: none;
      font-weight: 500;
    }

    .submenu a:hover {
      background: rgba(255,255,255,0.06);
    }

    .desktop {
      position: relative;
      z-index: 5;
      height: calc(100vh - 110px);
      padding: 20px;
      overflow: hidden;
    }

    .icon {
      position: absolute;
      width: 86px;
      text-align: center;
      padding: 8px 4px;
      border-radius: 8px;
      cursor: pointer;
      transition: transform 0.15s ease, background 0.15s ease;
      user-select: none;
      touch-action: none;
    }

    .icon:hover {
      background: rgba(255,255,255,0.08);
      transform: translateY(-2px);
    }

    .icon.dragging {
      cursor: grabbing;
      opacity: 0.85;
      transition: none;
    }

    .icon img {
      width: 48px;
      height: 48px;
      object-fit: contain;
      filter: brightness(1.2);
      margin-bottom: 6px;
    }

    .game-desktop-symbol {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      margin: 0 auto 6px;
      border-radius: 12px;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2);
      font-size: 25px;
    }

    .icon-label {
      font-size: 13px;
      text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .window-layer {
      position: absolute;
      inset: 0 0 110px 0;
      z-index: 10;
      pointer-events: none;
    }

    .window {
      position: absolute;
      width: 420px;
      min-height: 220px;
      border-radius: 12px 12px 0 0;
      background: rgba(25,25,25,0.96);
      border: 1px solid rgba(255,255,255,0.14);
      box-shadow: 0 18px 40px rgba(0,0,0,0.45);
      overflow: hidden;
      pointer-events: auto;
      transform-origin: center;
      display: none;
      flex-direction: column;
      --neon: rgba(76, 163, 255, 0.45);
    }

    .window[data-app="terminal"]   { --neon: rgba(46, 213, 115, 0.5); }
    .window[data-app="browser"]    { --neon: rgba(76, 163, 255, 0.5); }
    .window[data-app="vlc"]        { --neon: rgba(255, 111, 60, 0.5); }
    .window[data-app="vscode"]     { --neon: rgba(56, 139, 253, 0.5); }
    .window[data-app="copilot"]    { --neon: rgba(85, 247, 147, 0.5); }
    .window[data-app="linuxoffice"]{ --neon: rgba(255, 189, 46, 0.5); }
    .window[data-app="files"]      { --neon: rgba(255, 214, 92, 0.5); }
    .window[data-app="appearance"] { --neon: rgba(255, 92, 150, 0.5); }
    .window[data-app="wallet"]     { --neon: rgba(255, 165, 0, 0.5); }
    .window[data-app="bank"]       { --neon: rgba(255, 140, 26, 0.5); }
    .window[data-app="casino"]     { --neon: rgba(173, 57, 212, 0.5); }
    .window[data-app="gamestore"]  { --neon: rgba(233, 84, 32, 0.5); }

  
    .window.visible {
      display: flex;
      box-shadow: 0 18px 40px rgba(0,0,0,0.45), 0 0 36px 6px var(--neon);
      animation: neon-pulse 3.4s ease-in-out infinite;
    }

    body.neon-disabled .window.visible {
      animation: none;
      box-shadow: 0 18px 40px rgba(0,0,0,0.45);
    }

    body.color-disco .window.visible {
      animation: neon-pulse 1.2s ease-in-out infinite, color-disco 2.4s linear infinite;
    }

    body.liquid-glass .window {
      border: 1px solid rgba(255,255,255,0.38);
      border-radius: 24px;
      background: rgba(35,45,58,0.36);
      box-shadow: 0 22px 52px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.3);
      backdrop-filter: blur(24px) saturate(1.6);
    }

    body.liquid-glass .titlebar {
      background: rgba(255,255,255,0.13);
      border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    body.liquid-glass .window-content {
      background: rgba(12,18,28,0.22);
      backdrop-filter: blur(18px) saturate(1.35);
    }

    body.liquid-glass .app-card {
      background: rgba(255,255,255,0.13);
      border-color: rgba(255,255,255,0.22);
    }

    @keyframes neon-pulse {
      0%, 100% { box-shadow: 0 18px 40px rgba(0,0,0,0.45), 0 0 30px 4px var(--neon); }
      50%      { box-shadow: 0 18px 40px rgba(0,0,0,0.45), 0 0 48px 10px var(--neon); }
    }

    @keyframes color-disco {
      0%, 100% { filter: hue-rotate(0deg); }
      50% { filter: hue-rotate(180deg); }
    }

    .window.minimized {
      display: none !important;
    }

    .titlebar {
      height: 36px;
      background: linear-gradient(180deg, #3a3a3a, #252525);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 10px 0 12px;
      cursor: move;
      user-select: none;
      touch-action: none;
    }

    .titlebar .title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    .titlebar .title img {
      width: 18px;
      height: 18px;
      border-radius: 4px;
    }

    .window-actions {
      display: flex;
      gap: 8px;
    }

    .window-btn {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: none;
      cursor: pointer;
      opacity: 0.9;
      display: inline-block;
      position: relative;
      z-index: 10;
      pointer-events: auto;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25);
    }

    .window-btn.close { background: #ff5f57; }
    .window-btn.minimize { background: #ffbd2e; }
    .window-btn.maximize { background: #28c840; }

    .window-content {
      padding: 16px;
      color: var(--gray-100);
      background: rgba(15,15,15,0.82);
      min-height: 180px;
      flex: 1;
      min-width: 0;
      overflow: auto;
    }

    .code-editor-window {
      width: min(1120px, 94vw);
      height: min(760px, 86vh);
      min-height: 0;
    }
    .code-editor-window .window-content {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 0;
      overflow: hidden;
    }
    .code-editor-toolbar {
      display: flex;
      align-items: center;
      gap: 6px;
      min-height: 46px;
      padding: 7px 10px;
      border-bottom: 1px solid rgba(255,255,255,0.12);
      background: #202328;
    }
    .code-editor-views {
      display: flex;
      gap: 3px;
      margin-right: auto;
    }
    .code-editor-toolbar button,
    .code-editor-views button {
      min-height: 30px;
      padding: 5px 9px;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 4px;
      background: #30343a;
      color: #e8eaed;
      font: inherit;
      font-size: 12px;
      cursor: pointer;
    }
    .code-editor-toolbar button:hover,
    .code-editor-views button:hover,
    .code-editor-views button[aria-pressed="true"] {
      border-color: #6ab7ff;
      background: #263b4d;
      color: #fff;
    }
    .code-editor-toolbar .code-editor-run { background: #176b50; }
    .code-editor-toolbar .code-editor-run:hover { background: #208765; }
    .code-editor-status {
      min-height: 25px;
      padding: 4px 10px;
      border-top: 1px solid rgba(255,255,255,0.1);
      color: #aeb7c2;
      font-size: 11px;
    }
    .code-editor-workspace {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      flex: 1;
      min-height: 0;
      background: #15171a;
    }
    .code-editor-source,
    .code-editor-preview {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
    }
    .code-editor-source { border-right: 1px solid rgba(255,255,255,0.14); }
    .code-editor-pane-title {
      flex: 0 0 auto;
      padding: 7px 11px;
      background: #25282d;
      color: #c7cbd1;
      font-size: 11px;
      text-transform: uppercase;
    }
    .code-editor-textarea {
      flex: 1;
      width: 100%;
      min-height: 0;
      padding: 14px;
      resize: none;
      border: 0;
      outline: 0;
      background: #17191d;
      color: #d9e2ec;
      font: 13px/1.55 Consolas, "Courier New", monospace;
      tab-size: 2;
      white-space: pre;
      overflow: auto;
    }
    .code-editor-frame {
      flex: 1;
      width: 100%;
      min-height: 0;
      border: 0;
      background: #fff;
    }
    .code-editor-workspace[data-view="editor"] { grid-template-columns: minmax(0, 1fr); }
    .code-editor-workspace[data-view="editor"] .code-editor-preview { display: none; }
    .code-editor-workspace[data-view="preview"] { grid-template-columns: minmax(0, 1fr); }
    .code-editor-workspace[data-view="preview"] .code-editor-source { display: none; }

    .app-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 12px;
    }

    .software-window { width: min(760px, 90vw); min-height: 430px; }
    .software-tabs {
      display: flex;
      gap: 2px;
      overflow-x: auto;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255,255,255,0.12);
    }
    .software-tab {
      flex: 0 0 auto;
      border: 0;
      border-bottom: 2px solid transparent;
      padding: 8px 10px;
      background: transparent;
      color: #c8c8c8;
      cursor: pointer;
      font: inherit;
      font-size: 12px;
    }
    .software-tab:hover, .software-tab.active { color: #fff; border-bottom-color: #e95420; }
    .software-panel[hidden] { display: none; }
    .software-panel { padding-top: 16px; }
    .software-panel h3 { margin: 0 0 8px; font-size: 17px; }
    .software-panel p { color: #d1d1d1; line-height: 1.5; }
    .software-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 11px 0;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .software-row small { display: block; margin-top: 3px; color: #a9a9a9; }
    .software-row input[type="checkbox"] { width: 17px; height: 17px; accent-color: #e95420; }
    .software-action {
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 5px;
      padding: 8px 12px;
      background: #e95420;
      color: #fff;
      cursor: pointer;
      font: inherit;
    }

    .update-manager-window { width: min(560px, 88vw); min-height: 410px; }
    .update-manager { display: grid; gap: 14px; }
    .update-manager-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .update-manager-header h3 { margin: 0; font-size: 18px; }
    .update-manager-status { margin: 4px 0 0; color: #bdbdbd; font-size: 12px; }
    .update-manager-list { display: grid; gap: 8px; min-height: 178px; max-height: 220px; overflow-y: auto; }
    .update-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; background: rgba(255,255,255,0.04); }
    .update-item strong, .update-item small { display: block; }
    .update-item small { margin-top: 3px; color: #aaa; }
    .update-size { color: #d6d6d6; font-size: 12px; white-space: nowrap; }
    .update-manager-progress { height: 7px; border-radius: 5px; background: rgba(255,255,255,0.12); overflow: hidden; }
    .update-manager-progress span { display: block; width: 0; height: 100%; border-radius: inherit; background: #e95420; transition: width 0.25s ease; }
    .update-manager-actions { display: flex; justify-content: flex-end; gap: 8px; }
    .update-manager-actions button { border: 1px solid rgba(255,255,255,0.18); border-radius: 5px; padding: 8px 12px; background: rgba(255,255,255,0.1); color: #fff; cursor: pointer; font: inherit; }
    .update-manager-actions button.primary { background: #e95420; }
    .update-manager-actions button:disabled { cursor: wait; opacity: 0.55; }

    .pro-connect-backdrop {
      position: fixed;
      inset: 0;
      z-index: 60;
      pointer-events: auto;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(0,0,0,0.58);
    }
    .pro-connect-backdrop[hidden] { display: none; }
    .pro-connect-dialog {
      width: min(460px, 92vw);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 10px;
      background: #252525;
      box-shadow: 0 20px 48px rgba(0,0,0,0.55);
      color: #fff;
    }
    .pro-connect-header { display: flex; align-items: center; gap: 12px; padding: 18px 20px; border-bottom: 1px solid rgba(255,255,255,0.12); }
    .pro-connect-header strong { font-size: 17px; }
    .pro-connect-mark { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; background: #e95420; font-weight: 700; }
    .pro-connect-body { padding: 20px; }
    .pro-connect-body p { margin: 0 0 16px; color: #d5d5d5; line-height: 1.5; }
    .pro-connect-option { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border: 1px solid rgba(255,255,255,0.16); border-radius: 6px; margin-top: 10px; cursor: pointer; }
    .pro-connect-option:has(input:checked) { border-color: #e95420; background: rgba(233,84,32,0.12); }
    .pro-connect-option input { margin-top: 3px; accent-color: #e95420; }
    .pro-connect-option small { display: block; margin-top: 3px; color: #aaa; }
    .pro-connect-footer { display: flex; justify-content: flex-end; gap: 10px; padding: 14px 20px; border-top: 1px solid rgba(255,255,255,0.12); }
    .pro-connect-footer button { border: 1px solid rgba(255,255,255,0.2); border-radius: 5px; padding: 8px 14px; color: #fff; background: #3a3a3a; cursor: pointer; font: inherit; }
    .pro-connect-footer .pro-connect-confirm { background: #e95420; }
    .pro-connect-dialog.is-connecting .pro-connect-confirm { opacity: 0.65; pointer-events: none; }

    .sudo-command-list {
      max-height: 168px;
      margin: 8px 0 0;
      padding: 0 8px 0 20px;
      overflow-y: auto;
      font-family: Consolas, monospace;
      font-size: 12px;
      line-height: 1.7;
    }

    .sudo-command-list::-webkit-scrollbar { width: 8px; }
    .sudo-command-list::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.28);
      border-radius: 4px;
    }

    .terminal {
      background: #111;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      padding: 12px;
      font-family: Consolas, monospace;
      line-height: 1.5;
      min-height: 150px;
      white-space: pre-wrap;
    }

    .files-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .files-list li {
      display: flex;
      justify-content: space-between;
      padding: 8px 10px;
      border-radius: 6px;
      background: rgba(255,255,255,0.03);
      margin-bottom: 8px;
    }

    .file-browser {
      display: flex;
      flex-direction: column;
      gap: 12px;
      height: 100%;
    }

    .footer-terminal-btn {
      position: absolute;
      left: 44px;
      height: 24px;
      padding: 2px 8px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: transparent;
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      transition: background 0.15s ease, border-color 0.15s ease;
    }

    .footer-terminal-btn:hover,
    .footer-terminal-btn:focus-visible {
      background: rgba(255, 255, 255, 0.25);
      border-color: rgba(255, 255, 255, 0.6);
      outline: none;
    }

    .footer-terminal-btn img {
      width: 16px;
      height: 16px;
      object-fit: contain;
    }

    .browser-toolbar button {
      width: 30px;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 5px;
      background: rgba(255,255,255,0.08);
      color: #fff;
      cursor: pointer;
    }

    .browser-address {
      flex: 1;
      min-width: 0;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 5px;
      padding: 7px 10px;
      background: #141414;
      color: #fff;
      font: inherit;
      font-size: 13px;
    }

    .browser-frame {
      width: 100%;
      height: 100%;
      min-height: 240px;
      flex: 1;
      border: 0;
      background: #fff;
    }

    .browser-frame[hidden] {
      display: none;
    }

    .browser-blocked {
      display: grid;
      place-content: center;
      gap: 12px;
      flex: 1;
      min-height: 240px;
      padding: 24px;
      background: #171717;
      color: var(--gray-100);
      text-align: center;
    }

    .browser-blocked[hidden] {
      display: none;
    }

    .browser-empty {
      display: grid;
      place-content: center;
      flex: 1;
      min-height: 240px;
      padding: 24px;
      background: #171717;
      color: var(--gray-100);
      text-align: center;
    }

    .browser-empty[hidden] {
      display: none;
    }

    .browser-blocked button {
      justify-self: center;
      padding: 8px 12px;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 5px;
      background: var(--red-700);
      color: #fff;
      cursor: pointer;
      font: inherit;
    }

    .browser-window .window-content {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .browser-toolbar {
      display: flex;
      flex: 0 0 auto;
      gap: 8px;
      padding: 10px;
    }

    .server-window {
      width: min(620px, 86vw);
      min-height: 420px;
    }

    .server-form {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) auto;
      gap: 8px;
      margin-bottom: 14px;
    }

    .server-form input,
    .server-form textarea {
      min-width: 0;
      border: 1px solid rgba(255,255,255,0.16);
      border-radius: 5px;
      padding: 8px 10px;
      background: #141414;
      color: #fff;
      font: inherit;
    }

    .server-form textarea {
      grid-column: 1 / -1;
      min-height: 150px;
      resize: vertical;
    }

    .server-form .server-submit {
      grid-column: 3;
    }

    .server-form button,
    .server-page-actions button {
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 5px;
      padding: 8px 12px;
      background: rgba(255,255,255,0.1);
      color: #fff;
      cursor: pointer;
      font: inherit;
    }

    .server-page-list {
      display: grid;
      gap: 8px;
      max-height: 250px;
      overflow-y: auto;
    }

    .server-page {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 6px;
      background: rgba(255,255,255,0.04);
    }

    .server-page-details {
      min-width: 0;
      flex: 1;
    }

    .server-page-details strong,
    .server-page-details span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .server-page-details span {
      margin-top: 3px;
      color: #c9c9c9;
      font-size: 12px;
    }

    .server-page-actions {
