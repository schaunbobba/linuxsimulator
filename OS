    function getOfficeBaseRowsFromQuery() {
      const query = (officeBaseQueryInput.value || 'SELECT * FROM medewerkers').trim();
      const rows = Array.isArray(officeBaseData.rows) ? officeBaseData.rows : [];
      const match = query.match(/^SELECT\s+\*\s+FROM\s+([A-Za-z_]+)(?:\s+WHERE\s+([A-Za-z_]+)\s*(>=|<=|!=|=|>|<)\s*(.+))?$/i);
      if (!match) return rows;

      const [, tableName, rawField, operator, rawValue] = match;
      if (!tableName || tableName.toLowerCase() !== 'medewerkers') return rows;
      if (!rawField) return rows;

      const field = rawField.trim();
      const numericValue = Number(rawValue);
      const normalizedValue = Number.isFinite(numericValue) ? numericValue : String(rawValue).replace(/['"]/g, '').trim();

      return rows.filter(row => {
        const currentValue = row[field];
        if (currentValue === undefined) return false;
        switch (operator) {
          case '=': return currentValue == normalizedValue;
          case '!=': return currentValue != normalizedValue;
          case '>': return Number(currentValue) > Number(normalizedValue);
          case '<': return Number(currentValue) < Number(normalizedValue);
          case '>=': return Number(currentValue) >= Number(normalizedValue);
          case '<=': return Number(currentValue) <= Number(normalizedValue);
          default: return true;
        }
      });
    }

