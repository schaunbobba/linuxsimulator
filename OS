    const browserState = {
      history: [],
      currentIndex: -1
    };
    const browserAddress = document.getElementById('browser-address');
    const browserFrame = document.getElementById('browser-frame');
    const browserBlocked = document.getElementById('browser-blocked');
    const browserEmpty = document.getElementById('browser-empty');
    const browserBack = document.getElementById('browser-back');
    const browserForward = document.getElementById('browser-forward');
    const blockedEmbedHosts = ['facebook.com', 'instagram.com', 'google.com', 'x.com', 'linkedin.com'];

    function blocksEmbedding(url) {
      try {
        const hostname = new URL(url).hostname.replace(/^www\./, '');
        return blockedEmbedHosts.some(host => hostname === host || hostname.endsWith(`.${host}`));
      } catch {
        return false;
      }
    }

    function renderBrowser() {
      const page = browserState.history[browserState.currentIndex];
      const hasPage = Boolean(page);
      browserAddress.value = page ? (page.html ? `Lokale HTML: ${page.name}` : page.url) : '';
      browserEmpty.hidden = hasPage;
      if (!hasPage) {
        browserFrame.hidden = true;
        browserBlocked.hidden = true;
        browserBack.disabled = true;
        browserForward.disabled = true;
        return;
      }

      const isLocalHtml = Boolean(page.html);
      const isBlocked = !isLocalHtml && blocksEmbedding(page.url);
      browserFrame.hidden = isBlocked;
      browserBlocked.hidden = !isBlocked;
      if (!isBlocked) {
        if (isLocalHtml) {
          browserFrame.setAttribute('sandbox', 'allow-scripts allow-forms allow-modals allow-popups');
          browserFrame.removeAttribute('src');
          browserFrame.srcdoc = page.html;
        } else {
          browserFrame.removeAttribute('sandbox');
          browserFrame.removeAttribute('srcdoc');
          browserFrame.src = page.url;
        }
      }
      browserBack.disabled = browserState.currentIndex === 0;
      browserForward.disabled = browserState.currentIndex === browserState.history.length - 1;
    }

    function moveBrowserHistory(offset) {
      const nextIndex = browserState.currentIndex + offset;
      if (nextIndex < 0 || nextIndex >= browserState.history.length) return;

      browserState.currentIndex = nextIndex;
      renderBrowser();
    }

    function reloadBrowser() {
      const page = browserState.history[browserState.currentIndex];
      if (!page) return;
      if (page.html) browserFrame.srcdoc = page.html;
      else if (!blocksEmbedding(page.url)) browserFrame.src = page.url;
    }

    function openBrowserPage(page) {
      browserState.history = browserState.history.slice(0, browserState.currentIndex + 1);
      browserState.history.push(page);
      browserState.currentIndex += 1;
      renderBrowser();
      openApp('browser');
    }

