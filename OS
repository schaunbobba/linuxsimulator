            termCwd = 'home';
            updateTerminalPrompt();
            fileExplorerState.current = 'home';
            renderFilesExplorer();
          } else if (targetPath === '..') {
            if (termCwd === 'archive') termCwd = 'documents';
            else if (termCwd !== 'home') termCwd = 'home';
            updateTerminalPrompt();
            fileExplorerState.current = termCwd;
            renderFilesExplorer();
          } else {
            const foundFolder = currentDirObj.items.find(i => i.type === 'folder' && i.name.toLowerCase() === targetPath.toLowerCase());
            if (foundFolder) {
              const key = foundFolder.target || foundFolder.name.toLowerCase();
              if (fileExplorerData[key]) {
                termCwd = key;
                updateTerminalPrompt();
                fileExplorerState.current = key;
                renderFilesExplorer();
              } else {
                printTermLine(`bash: cd: ${escapeHtml(targetPath)}: Kan de map niet openen`, 'error');
              }
            } else {
              printTermLine(`bash: cd: ${escapeHtml(targetPath)}: Bestand of map bestaat niet`, 'error');
            }
          }
          break;

        case 'cat':
          if (!cmdArgs[0]) {
            printTermLine('Gebruik: cat <bestandsnaam>', 'error');
            break;
          }
          const catItem = currentDirObj.items.find(i => i.name.toLowerCase() === cmdArgs[0].toLowerCase());
          if (!catItem) {
            printTermLine(`cat: ${escapeHtml(cmdArgs[0])}: Bestand of map bestaat niet`, 'error');
          } else if (catItem.type === 'folder') {
            printTermLine(`cat: ${escapeHtml(cmdArgs[0])}: Is een map`, 'error');
          } else {
            const content = catItem.content !== undefined ? catItem.content : `[Inhoud van ${catItem.name}]\nBestand opgeslagen in ${currentDirObj.path}.`;
            printTermLine(escapeHtml(content));
          }
          break;

        case 'touch':
          if (!cmdArgs[0]) {
            printTermLine('Gebruik: touch <bestandsnaam>', 'error');
            break;
          }
          const newFileName = cmdArgs[0];
          const existingFile = currentDirObj.items.find(i => i.name.toLowerCase() === newFileName.toLowerCase());
          if (!existingFile) {
            currentDirObj.items.push({ name: newFileName, type: 'file', meta: '0 bytes', content: '' });
            renderFilesExplorer();
            printTermLine(`Bestand '${escapeHtml(newFileName)}' aangemaakt.`, 'success');
          } else {
            printTermLine(`Bestand '${escapeHtml(newFileName)}' bijgewerkt (timestamp).`);
          }
          break;

        case 'mkdir':
          if (!cmdArgs[0]) {
            printTermLine('Gebruik: mkdir <mapnaam>', 'error');
            break;
          }
          const newFolderName = cmdArgs[0];
          const existingDir = currentDirObj.items.find(i => i.name.toLowerCase() === newFolderName.toLowerCase());
          if (existingDir) {
            printTermLine(`mkdir: kan map '${escapeHtml(newFolderName)}' niet aanmaken: Map bestaat al`, 'error');
          } else {
            const folderKey = newFolderName.toLowerCase();
            currentDirObj.items.push({ name: newFolderName, type: 'folder', target: folderKey, meta: '0 items' });
            fileExplorerData[folderKey] = {
              label: newFolderName,
              path: (currentDirObj.path || '/home') + '/' + newFolderName,
              items: []
            };
            renderFilesExplorer();
            printTermLine(`Map '${escapeHtml(newFolderName)}' aangemaakt.`, 'success');
          }
          break;

        case 'rm':
          if (!cmdArgs[0]) {
            printTermLine('Gebruik: rm <naam>', 'error');
            break;
          }
          const rmTarget = cmdArgs.filter(a => !a.startsWith('-'))[0];
          if (!rmTarget) {
            printTermLine('Gebruik: rm <naam>', 'error');
            break;
          }
          const idx = currentDirObj.items.findIndex(i => i.name.toLowerCase() === rmTarget.toLowerCase());
          if (idx !== -1) {
            const removed = currentDirObj.items.splice(idx, 1)[0];
            renderFilesExplorer();
            printTermLine(`'${escapeHtml(removed.name)}' is verwijderd.`, 'success');
          } else {
            printTermLine(`rm: kan '${escapeHtml(rmTarget)}' niet verwijderen: Bestand of map bestaat niet`, 'error');
          }
          break;

        case 'apt': {
          const aptAction = cmdArgs[0] === 'instal' ? 'install' : cmdArgs[0] === 'romove' ? 'remove' : cmdArgs[0] === 'updat' ? 'update' : cmdArgs[0];
          const packageName = cmdArgs.slice(1).filter(arg => !arg.startsWith('-')).join(' ').trim();
          const resetTarget = packageName.toLowerCase();
          const neonAction = cmdArgs[1];

          if (aptAction === 'copyright' && cmdArgs[1]?.toLowerCase() === 'info') {
            const copyrightText = [
              'Deze software, inclusief alle modules, interfaces, financiële systemen, grafische elementen, scripts, kernelsimulaties, browsersimulaties, Appstore-componenten en interne economische systemen, is een creatie van Shaun Bodde.',
              '',
              'Het is niet toegestaan om deze simulator, of onderdelen daarvan, te kopiëren, verspreiden, wijzigen, decompileren, reverse-engineeren of te herpubliceren zonder voorafgaande schriftelijke toestemming van de auteur.',
              '',
              'De naam Linux OS, het ontwerp van het OS-ecosysteem, de financiële engine, de Appstore-architectuur, de kernel-simulatie en alle bijbehorende systemen vallen onder intellectueel eigendom van Shaun Bodde.',
              '',
              'Gebruik van deze software is uitsluitend toegestaan binnen de voorwaarden die door de auteur zijn vastgesteld.',
              '',
              'Linux OS © 2026 Shaun Bodde - alle rechten voorbehouden'
            ].map(escapeHtml).join('\n');
            printTermLine(copyrightText);
            break;
          }

          if (aptAction === 'update') {
            packageListsUpdated = true;
            printTermLine(`Hit:1 http://nl.archive.ubuntu.com/ubuntu noble InRelease
Get:2 http://nl.archive.ubuntu.com/ubuntu noble-updates InRelease [126 kB]
Get:3 http://security.ubuntu.com/ubuntu noble-security InRelease [126 kB]
Get:4 http://nl.archive.ubuntu.com/ubuntu noble-updates/main amd64 Packages [1.242 kB]
Fetched 1.494 kB in 1s (1.026 kB/s)
Reading package lists... Done
Building dependency tree... Done
Reading state information... Done
<span class="terminal-success-text">${systemUpgradeAvailable ? '2 packages can be upgraded. Run \'apt list --upgradable\' to see them.' : 'All packages are up to date.'}</span>`);
            break;
          }
          if (aptAction === 'upgrade') {
            if (!packageListsUpdated) {
              printTermLine(`Hit:1 http://nl.archive.ubuntu.com/ubuntu noble InRelease
Reading package lists... Done
Building dependency tree... Done
Reading state information... Done
<span class="terminal-success-text">All packages are up to date.</span>`);
            } else if (systemUpgradeAvailable) {
              systemUpgradeAvailable = false;
              printTermLine(`Reading package lists... Done
Building dependency tree... Done
Reading state information... Done
Calculating upgrade... Done
The following packages will be upgraded:
  linux-simulator-core linux-simulator-desktop
2 upgraded, 0 newly installed, 0 to remove and 0 not upgraded.
Need to get 18,4 MB of archives.
After this operation, 0 B of additional disk space will be used.
Get:1 http://nl.archive.ubuntu.com/ubuntu noble-updates/main amd64 linux-simulator-core [12,1 MB]
Get:2 http://nl.archive.ubuntu.com/ubuntu noble-updates/main amd64 linux-simulator-desktop [6,3 MB]
Fetched 18,4 MB in 2s (9.200 kB/s)
Preparing to unpack ...
Setting up linux-simulator-core (2.0.1) ...
Setting up linux-simulator-desktop (2.0.1) ...
Processing triggers for man-db (2.12.0-4build2) ...
<span class="terminal-success-text">Upgrade complete.</span>`);
            } else {
              printTermLine(`Reading package lists... Done
Building dependency tree... Done
Reading state information... Done
<span class="terminal-success-text">0 upgraded, 0 newly installed, 0 to remove and 0 not upgraded.</span>`);
            }
            break;
          }
          if (aptAction === 'play') {
            const game = cmdArgs[1] && cmdArgs[1].toLowerCase();
            if (!playableGames.has(game)) {
              printTermLine('Kies een spel uit de Sudo commando lijst.', 'error');
              break;
            }
            startTerminalGame(game);
            break;
          }
          if (aptAction === 'set' && cmdArgs[1]?.toLowerCase() === 'casino' && cmdArgs[2]?.toLowerCase() === 'jackpot') {
            const jackpotAmount = Number(String(cmdArgs[3] || '').replace(',', '.'));
            if (!Number.isFinite(jackpotAmount) || jackpotAmount <= 0) {
              printTermLine('Gebruik: sudo apt set casino jackpot <bedrag> (bedrag moet groter zijn dan 0)', 'error');
              break;
            }
            casinoChips = jackpotAmount;
            renderCasinoChips();
            persistCasinoState();
            printTermLine(`Casinojackpot ingesteld op <span class="terminal-success-text">${escapeHtml(formatEuro(jackpotAmount))}</span>.`, 'success');
            break;
          }
          if (aptAction === 'set' && cmdArgs[1]?.toLowerCase() === 'failures') {
            const failuresAction = cmdArgs[2]?.toLowerCase();
            if (failuresAction !== 'on' && failuresAction !== 'off') {
              printTermLine('Gebruik: sudo apt set failures on|off', 'error');
              break;
            }
            simFailuresEnabled = failuresAction === 'on';
            printTermLine(`Willekeurige storingen zijn ${simFailuresEnabled ? 'ingeschakeld' : 'uitgeschakeld'}.`, 'success');
            break;
          }
          if (aptAction === 'reset' && resetTarget === 'sim') {
            document.body.classList.remove('safe-mode', 'neon-disabled', 'color-disco', 'liquid-glass');
            coreProtected = false;
            printTermLine('Simulatorinstellingen zijn hersteld.', 'success');
            break;
          }
          if (aptAction === 'reset' && resetTarget === 'banksaldo') {
            bankBetaalBalance = 0;
            bankSpaarBalance = 0;
            bankLoan = { principal: 0, outstanding: 0, annualRate: 0, termMonths: 0, monthlyPayment: 0 };
            bankWalletBtc = 0;
            bankMonthCount = 1;
            bankNextSalaryAt = getNextRealTimeSalaryAt(Date.now());
            bankTransactions = [];
            renderBankBalances();
            renderBankTransactions();
            updateBankCountdown();
            persistBankState();
            casinoChips = 0;
            casinoTransactions = [];
            renderCasinoChips();
            renderCasinoTransactions();
            persistCasinoState();
            printTermLine('Banksaldo, Banklening, Bitcoin Wallet en Casino zijn volledig gereset (inclusief recente mutaties).', 'success');
            break;
          }
          if (aptAction === 'reset' && resetTarget === 'bitcoin wallet') {
            bankWalletBtc = 0;
            renderBankBalances();
            persistBankState();
            printTermLine('Bitcoin Wallet is volledig op nul gezet.', 'success');
            break;
          }
          if (aptAction === 'reboot') {
            document.querySelectorAll('.window.visible').forEach(windowEl => closeWindow(windowEl.id));
            openApp('home');
            printTermLine('Simulator is opnieuw gestart.', 'success');
            break;
          }
          if (aptAction === 'shutdown') {
            document.querySelectorAll('.window.visible').forEach(windowEl => closeWindow(windowEl.id));
            printTermLine('Simulator is afgesloten.', 'success');
            break;
          }
          if (aptAction === 'safe-mode') {
            document.body.classList.add('safe-mode');
            printTermLine('Veilige modus is ingeschakeld.', 'success');
            break;
          }
          if (aptAction === 'version') {
            printTermLine('Linux Simulator versie 2.0.0');
            break;
          }
          if (aptAction === 'protect-core' || aptAction === 'unprotect-core') {
            coreProtected = aptAction === 'protect-core';
            printTermLine(`Systeemkern is ${coreProtected ? 'beveiligd' : 'niet meer beveiligd'}.`, 'success');
            break;
          }
          if (aptAction === 'lock' || aptAction === 'unlock') {
            lockScreen.hidden = aptAction === 'unlock';
            printTermLine(aptAction === 'lock' ? 'Scherm is vergrendeld.' : 'Scherm is ontgrendeld.', 'success');
            break;
          }
          if (aptAction === 'neon') {
            if (neonAction === 'on') document.body.classList.remove('neon-disabled');
            else if (neonAction === 'off') document.body.classList.add('neon-disabled');
            else if (cmdArgs[1] === 'collordisco' && cmdArgs[2] === 'on') document.body.classList.add('color-disco');
            else if (cmdArgs[1] === 'collordisco' && cmdArgs[2] === 'off') document.body.classList.remove('color-disco');
            else if (neonAction === 'reset') document.body.classList.remove('neon-disabled', 'color-disco');
            else {
              printTermLine('Gebruik: sudo apt neon on|off|reset of sudo apt neon collordisco on|off', 'error');
              break;
            }
            printTermLine('Neoninstellingen zijn bijgewerkt.', 'success');
            break;
          }
          if (aptAction === 'liquid' && cmdArgs[1] === 'glass') {
            const liquidGlassAction = cmdArgs[2];
            if (liquidGlassAction !== 'on' && liquidGlassAction !== 'off') {
              printTermLine('Gebruik: sudo apt liquid glass on|off', 'error');
              break;
            }
            document.body.classList.toggle('liquid-glass', liquidGlassAction === 'on');
            printTermLine(`Liquid glass is ${liquidGlassAction === 'on' ? 'ingeschakeld' : 'uitgeschakeld'}.`, 'success');
            break;
          }
          if (!['install', 'remove'].includes(aptAction) || !packageName) {
            printTermLine('Gebruik: sudo apt install <pakket>, sudo apt remove <pakket> of sudo apt update', 'error');
            break;
          }

          const packageKey = packageName.toLowerCase();
          if (GAMESTORE_GAMES.some(game => game.name.toLowerCase() === packageKey)) {
            printTermLine('Games uit de Linux Gamestore kunnen alleen via de Linux Gamestore zelf geinstalleerd of verwijderd worden.', 'error');
            break;
          }
          if (aptAction === 'install') {
            if (installedPackages.has(packageKey)) {
              printTermLine(`${escapeHtml(packageName)} is al de nieuwste versie.`);
            } else {
              installedPackages.add(packageKey);
              createInstalledApp(packageName);
              printTermLine(`${escapeHtml(packageName)} is geinstalleerd. Start met: open ${escapeHtml(packageName)}`, 'success');
            }
          } else {
            installedPackages.delete(packageKey);
            removeInstalledApp(packageName);
            printTermLine(`${escapeHtml(packageName)} is verwijderd.`, 'success');
          }
          break;
        }

        case 'echo':
          if (trimmed.includes('>')) {
            const redirectParts = trimmed.substring(5).split('>');
            const textToSave = redirectParts[0].trim().replace(/^["']|["']$/g, '');
            const targetFile = redirectParts[1].trim();
            if (targetFile) {
              let fItem = currentDirObj.items.find(i => i.name.toLowerCase() === targetFile.toLowerCase());
              if (!fItem) {
                fItem = { name: targetFile, type: 'file', content: textToSave, meta: `${textToSave.length} bytes` };
                currentDirObj.items.push(fItem);
              } else {
                fItem.content = textToSave;
                fItem.meta = `${textToSave.length} bytes`;
              }
              renderFilesExplorer();
              printTermLine(`Geschreven naar '${escapeHtml(targetFile)}'.`, 'success');
              break;
            }
          }
          printTermLine(escapeHtml(cmdArgs.join(' ')));
          break;

        case 'whoami':
          printTermLine('shaun');
          break;

        case 'uname':
          printTermLine('Linux Simulator 6.8.0-52-generic #1 SMP PREEMPT_DYNAMIC x86_64 GNU/Linux');
          break;

        case 'hostname':
          printTermLine('linux-simulator');
          break;

        case 'date':
          printTermLine(escapeHtml(new Date().toString()));
          break;

        case 'uptime':
          const seconds = Math.floor((Date.now() - termStartTime) / 1000);
          const mins = Math.floor(seconds / 60);
          const hrs = Math.floor(mins / 60);
          printTermLine(`up ${hrs} uur, ${mins % 60} minuten, 1 gebruiker, load average: 0.08, 0.04, 0.01`);
          break;

        case 'neofetch':
        case 'fastfetch':
          printTermLine(`
<span class="terminal-prompt-text">       .---.          user@linuxsimulator:~$</span>
<span class="terminal-prompt-text">      /     \\         ----------------------</span>
<span class="terminal-prompt-text">     | () () |        OS:</span> Shaun Bodde x86_64
<span class="terminal-prompt-text">      \\  =  /         Host:</span> Linux Simulator v2.0
<span class="terminal-prompt-text">       |||||          Kernel:</span> 6.8.0-52-generic
                      <span class="terminal-prompt-text">Uptime:</span> ${Math.floor((Date.now() - termStartTime)/60000)} minuten
                      <span class="terminal-prompt-text">Shell:</span> bash 5.2.21
                      <span class="terminal-prompt-text">DE:</span> GNOME-compatible Desktop
                      <span class="terminal-prompt-text">Terminal:</span> HTML5 Interactive Terminal
                      <span class="terminal-prompt-text">CPU:</span> Virtual Intel Core i9-13900K (16)
                      <span class="terminal-prompt-text">Memory:</span> 2048MiB / 16384MiB
`);
          break;

        case 'systemctl':
          printTermLine(`
● linux-simulator.service - Shaun Bodde Linux Core Services
     Loaded: loaded (/etc/systemd/system/linux-simulator.service; enabled; vendor preset: enabled)
     Active: <span class="terminal-success-text">active (running)</span> since ${new Date().toLocaleTimeString()}
   Main PID: 1337 (systemd)
      Tasks: 14 (limit: 4915)
     Memory: 48.6M
     CGroup: /system.slice/linux-simulator.service
             └─1337 /usr/bin/python3 -m simulator.core
`);
          break;

        case 'ping':
          const host = cmdArgs[0] || 'shaunbodde.nl';
          printTermLine(`PING ${escapeHtml(host)} (192.168.1.100) 56(84) bytes of data.`);
          printTermLine(`64 bytes from ${escapeHtml(host)}: icmp_seq=1 ttl=64 time=12.4 ms`);
          printTermLine(`64 bytes from ${escapeHtml(host)}: icmp_seq=2 ttl=64 time=10.1 ms`);
          printTermLine(`64 bytes from ${escapeHtml(host)}: icmp_seq=3 ttl=64 time=11.8 ms`);
          printTermLine(`--- ${escapeHtml(host)} ping statistics ---`);
          printTermLine(`3 packets transmitted, 3 received, 0% packet loss, time 2003ms`);
          break;

        case 'open':
        case 'xdg-open':
          if (!cmdArgs[0]) {
            printTermLine('Gebruik: open <appnaam> (bijv. firefox, files, vlc, vscode, copilot, wallet, terminal)', 'error');
          } else {
            const appToOpen = cmdArgs[0].toLowerCase();
            const desktopAppId = desktopAppIdFromPackage(appToOpen);
            const targetApp = desktopAppId || appIdFromPackage(appToOpen);
            if (desktopAppId && removedDesktopApps.has(desktopAppId)) {
              printTermLine(`Applicatie '${escapeHtml(appToOpen)}' is niet geinstalleerd.`, 'error');
            } else {
              openApp(targetApp);
              printTermLine(`Applicatie '${escapeHtml(appToOpen)}' geopend.`, 'success');
            }
          }
          break;

        case 'calc':
        case 'math':
          if (!cmdArgs[0]) {
            printTermLine('Gebruik: calc <expressie> (bijv. calc 25 * 4)', 'error');
          } else {
            try {
              const expr = cmdArgs.join(' ').replace(/[^0-9+\-*/().\s]/g, '');
              const result = Function('"use strict";return (' + expr + ')')();
              printTermLine(`= <span class="terminal-success-text">${result}</span>`);
            } catch (err) {
              printTermLine('Ongeldige wiskundige expressie', 'error');
            }
          }
          break;

        case 'clear':
          if (terminalOutput) terminalOutput.innerHTML = '';
          break;

        case 'history':
          if (termHistory.length === 0) {
            printTermLine('(geen commando geschiedenis)');
          } else {
            const histStr = termHistory.map((h, i) => `  ${i + 1}  ${escapeHtml(h)}`).join('\n');
            printTermLine(histStr);
          }
          break;

        case 'exit':
          closeWindow('window-terminal');
          break;

        case 'hangman':
          startHangman();
          break;

        case 'reboot':
          document.querySelectorAll('.window.visible').forEach(windowEl => closeWindow(windowEl.id));
          openApp('home');
          printTermLine('Simulator is opnieuw gestart.', 'success');
          break;

        case 'shutdown':
        case 'poweroff':
        case 'halt':
          document.querySelectorAll('.window.visible').forEach(windowEl => closeWindow(windowEl.id));
          printTermLine('Simulator is afgesloten.', 'success');
          break;

        case 'sudo':
          if (cmdArgs.length > 0) {
            printTermLine('[sudo] password for Linux Simulator:');
            handleTerminalCommand(cmdArgs.join(' '));
          } else {
            printTermLine('usage: sudo command');
          }
          break;

        default:
          printTermLine(`bash: ${escapeHtml(command)}: commando niet gevonden. Typ <span class="terminal-prompt-text">help</span> voor hulp.`, 'error');
          break;
      }
    }

    if (terminalInput) {
      terminalInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const val = terminalInput.value;
          terminalInput.value = '';
          handleTerminalCommand(val);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (termHistory.length > 0 && termHistoryIndex > 0) {
            termHistoryIndex--;
            terminalInput.value = termHistory[termHistoryIndex];
          }
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (termHistoryIndex < termHistory.length - 1) {
            termHistoryIndex++;
            terminalInput.value = termHistory[termHistoryIndex];
          } else {
            termHistoryIndex = termHistory.length;
            terminalInput.value = '';
          }
        } else if (e.key === 'Tab') {
          e.preventDefault();
          const val = terminalInput.value;
          if (!val) return;
          const currentDirObj = fileExplorerData[termCwd] || fileExplorerData.home;
          const items = currentDirObj.items || [];
          const builtins = ['help', 'pwd', 'ls', 'll', 'cd', 'cat', 'touch', 'mkdir', 'rm', 'echo', 'whoami', 'uname', 'hostname', 'date', 'uptime', 'neofetch', 'systemctl', 'ping', 'open', 'calc', 'history', 'clear', 'exit'];
          const parts = val.split(' ');
          if (parts.length === 1) {
            const match = builtins.find(b => b.startsWith(parts[0].toLowerCase()));
            if (match) terminalInput.value = match + ' ';
          } else {
            const lastArg = parts[parts.length - 1].toLowerCase();
            const matchItem = items.find(i => i.name.toLowerCase().startsWith(lastArg));
            if (matchItem) {
              parts[parts.length - 1] = matchItem.name;
              terminalInput.value = parts.join(' ');
            }
          }
        }
      });
    }

    if (terminalContainer) {
      terminalContainer.addEventListener('click', () => {
        if (terminalInput) terminalInput.focus();
      });
    }

    const origOpenApp = openApp;
    openApp = function(appName) {
      origOpenApp(appName);
      const resolved = resolveAppName(appName);
      if (resolved === 'terminal' && terminalInput) {
        setTimeout(() => terminalInput.focus(), 50);
      }
    };

    initTerminalBanner();

    renderBrowser();
    renderServerPages();
    renderKernelSimulation();
    updateFooterClock();
    setInterval(updateFooterClock, 1000);
    setInterval(updateKernelSimulation, 2000);

    renderFilesExplorer();
    renderDocumentsWindow();
    renderOfficeDocuments();
  </script>
</body>
</html>
