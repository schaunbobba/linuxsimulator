      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
      padding: 8px 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 6px;
      flex-wrap: wrap;
    }

    .office-base-query {
      width: 100%;
      padding: 9px 10px;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 4px;
      background: rgba(8,8,8,0.55);
      color: #fff;
      font: inherit;
      margin-bottom: 10px;
    }

    .office-base-grid-wrap {
      overflow: auto;
      max-height: 420px;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 6px;
      background: rgba(255,255,255,0.02);
    }

    .office-base-table {
      width: 100%;
      min-width: 620px;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .office-base-table th,
    .office-base-table td {
      border: 1px solid rgba(255,255,255,0.12);
      padding: 8px 10px;
      text-align: left;
      background: rgba(255,255,255,0.02);
    }

    .office-base-table th {
      background: rgba(255,255,255,0.08);
      color: #dfe7ff;
      font-size: 12px;
      text-transform: lowercase;
    }

    .office-base-table input {
      width: 100%;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 4px;
      background: rgba(8,8,8,0.45);
      color: #fff;
      padding: 6px 8px;
      font: inherit;
    }

    .office-base-table button {
      padding: 6px 8px;
      border-radius: 4px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(239,68,68,0.18);
      color: #fff;
      cursor: pointer;
      font: inherit;
    }

    .office-impress {
      display: none;
      margin-top: 12px;
      padding: 12px;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 8px;
      background: rgba(255,255,255,0.03);
    }

    .office-impress.visible {
      display: block;
    }

    .office-impress-toolbar {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .office-impress-editor {
      display: grid;
      gap: 12px;
    }

    .office-impress-title {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 6px;
      background: rgba(8,8,8,0.55);
      color: #fff;
      font: 700 18px/1.2 "Segoe UI", sans-serif;
    }

    .office-impress-bullets {
      width: 100%;
      min-height: 140px;
      padding: 12px 14px;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 6px;
      background: #111827;
      color: #fff;
      font: 14px/1.5 "Cascadia Code", Consolas, monospace;
      resize: vertical;
    }

    .office-impress-preview {
      margin-top: 14px;
      padding: 18px 20px;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(55,65,81,0.9), rgba(17,24,39,0.95));
      border: 1px solid rgba(255,255,255,0.12);
      min-height: 180px;
    }

    .office-impress-preview h3 {
      margin: 0 0 12px;
      font-size: 26px;
      color: #fff;
    }

    .office-impress-preview ul {
      margin: 0;
      padding-left: 20px;
      color: #e5e7eb;
      line-height: 1.8;
    }

    .office-draw-tools {
      display: none;
      align-items: center;
      gap: 10px;
      margin-top: 12px;
    }

    .office-draw-tools.visible {
      display: flex;
    }

    .office-canvas {
      display: none;
      width: 100%;
      height: 360px;
      margin-top: 12px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 6px;
      background-color: #fff;
      background-image: linear-gradient(#dbe4ee 1px, transparent 1px), linear-gradient(90deg, #dbe4ee 1px, transparent 1px);
      background-size: 20px 20px;
      cursor: crosshair;
      touch-action: none;
    }

    .office-canvas.visible {
      display: block;
    }

    .vlc-volume {
      width: 120px;
      accent-color: var(--red-700);
    }

    .file-breadcrumb {
      font-size: 12px;
      color: #d9d9d9;
      padding: 0 4px;
    }

    .folder-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 12px;
    }

    .folder-item {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 12px 10px;
      text-align: center;
      color: #fff;
      cursor: pointer;
      transition: transform 0.12s ease, background 0.12s ease;
      user-select: none;
    }

    .folder-item:hover {
      transform: translateY(-2px);
      background: rgba(255,255,255,0.08);
    }

    .folder-item .glyph {
      font-size: 26px;
      display: block;
      margin-bottom: 8px;
    }

    .folder-item small {
      display: block;
      color: #d8d8d8;
      margin-top: 4px;
      font-size: 11px;
    }

    .footer {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 20;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(180deg, var(--red-700), var(--red-600));
      box-shadow: 0 -2px 6px var(--shadow);
      color: #fff;
      font-size: 12px;
      font-weight: 600;
    }

    .footer-clock {
      white-space: nowrap;
    }

    .footer-salary {
      white-space: nowrap;
      margin-left: 12px;
      padding: 2px 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.14);
      font-size: 11px;
      letter-spacing: 0.2px;
    }

    .shutdown-button {
      position: absolute;
      left: 12px;
      width: 24px;
      height: 24px;
      padding: 0;
      border: 0;
      background: transparent;
      color: #fff;
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
    }

    .shutdown-button:hover,
    .shutdown-button:focus-visible {
      background: rgba(255, 255, 255, 0.16);
      outline: none;
    }

    .terminal-window {
      width: min(680px, 88vw);
      min-height: 380px;
    }

    .kernel-window {
      width: min(760px, 88vw);
      min-height: 480px;
    }

    .kernel-sim {
      display: grid;
      gap: 14px;
    }

    .kernel-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .kernel-panel {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 12px 14px;
    }

    .kernel-panel h3 {
      margin: 0 0 12px;
      font-size: 14px;
      letter-spacing: 0.04em;
      color: #dfe7ff;
      text-transform: uppercase;
    }

    .kernel-meter {
      width: 100%;
      height: 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.08);
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .kernel-meter span {
      display: block;
      width: 0;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #22c55e, #84cc16, #facc15, #f97316);
      transition: width 0.25s ease;
    }

    .kernel-meter.memory span {
      background: linear-gradient(90deg, #60a5fa, #3b82f6, #8b5cf6);
    }

    .kernel-metrics {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 8px;
      font-size: 12px;
      color: #d9d9d9;
    }

    .kernel-metrics strong {
      font-size: 20px;
      color: #fff;
    }

    .kernel-action-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }

    .kernel-btn {
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 6px;
      background: rgba(255,255,255,0.08);
      color: #fff;
      padding: 7px 11px;
      cursor: pointer;
      font: inherit;
      font-size: 12px;
    }

    .kernel-btn:hover {
      background: rgba(255,255,255,0.12);
    }

    .process-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    .process-table th,
    .process-table td {
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 7px 6px;
      text-align: left;
    }

    .process-table th {
      color: #dfe7ff;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-size: 11px;
    }

    .kernel-log {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 6px;
      max-height: 150px;
      overflow-y: auto;
      font-family: Consolas, monospace;
      font-size: 12px;
      line-height: 1.5;
    }

    .kernel-log li {
      padding: 6px 8px;
      border-radius: 6px;
      background: rgba(255,255,255,0.03);
      color: #dfe7ff;
    }

    .terminal-container {
      background: #0c0c0c;
      color: #e2e8f0;
      font-family: "Cascadia Code", "Fira Code", Consolas, "Courier New", monospace;
      font-size: 13px;
      line-height: 1.5;
      padding: 14px;
      min-height: 330px;
      max-height: 520px;
      height: 100%;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      cursor: text;
    }

    .terminal-output {
      white-space: pre-wrap;
      word-break: break-word;
    }

    .terminal-line {
      margin-bottom: 4px;
    }

    .terminal-prompt-text {
      color: #38bdf8;
      font-weight: 600;
    }

    .terminal-cmd-text {
      color: #f8fafc;
      font-weight: 500;
    }

    .terminal-out-text {
      color: #cbd5e1;
    }

    .terminal-error-text {
      color: #f87171;
    }

    .terminal-success-text {
      color: #4ade80;
    }

    .terminal-dir-text {
      color: #60a5fa;
      font-weight: bold;
    }

    .terminal-file-text {
      color: #e2e8f0;
    }

    .terminal-input-line {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }

    .terminal-prompt {
      color: #38bdf8;
      font-weight: bold;
      white-space: nowrap;
      user-select: none;
    }

    .terminal-input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #00ff66;
      font-family: inherit;
      font-size: inherit;
      padding: 0;
      margin: 0;
    }

    .power-menu {
      position: fixed;
      bottom: 40px;
      left: 10px;
      z-index: 40;
      display: none;
      width: 210px;
      padding: 6px;
      background: rgba(28, 28, 28, 0.98);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 8px;
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.45);
    }

    .power-menu.visible {
      display: grid;
      gap: 3px;
    }

    .power-menu button {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 9px 10px;
      border: 0;
      border-radius: 5px;
      background: transparent;
      color: #fff;
      cursor: pointer;
      font: inherit;
      text-align: left;
    }

    .power-menu button:hover,
    .power-menu button:focus-visible {
      background: var(--red-700);
      outline: none;
    }

    .power-menu .power-icon {
      width: 18px;
      font-size: 16px;
      text-align: center;
    }

    .lock-screen {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: grid;
      place-content: center;
      gap: 16px;
      background: rgba(17, 17, 17, 0.94);
      color: #fff;
      text-align: center;
    }

    .lock-screen[hidden] {
      display: none;
    }

    .unlock-button {
      padding: 9px 18px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 5px;
      background: var(--red-700);
      color: #fff;
      cursor: pointer;
      font: inherit;
    }

    body.sleeping .desktop,
    body.sleeping .window-layer,
    body.sleeping .dock {
      opacity: 0.2;
    }

    .dock {
      position: fixed;
      left: 50%;
      bottom: 42px;
      transform: translateX(-50%);
      background: rgba(20,20,20,0.82);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 10px 18px;
      display: flex;
      gap: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.4);
      z-index: 30;
      backdrop-filter: blur(3px);
    }

    .dock-item {
      border: none;
      background: transparent;
      padding: 0;
      cursor: pointer;
      position: relative;
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      transition: transform 0.15s ease,
                  background 0.15s ease;
    }

    .dock-item:hover {
      transform: translateY(-3px) scale(1.08);
      background: rgba(255,255,255,0.08);
    }

    .dock-item img {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }

    .dock-item.active::after {
      content: "";
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 8px rgba(255,255,255,0.7);
    }

    @media (max-width: 760px) {
      .desktop {
        padding: 12px;
      }

      .window {
        width: min(88vw, 420px);
      }

      .vlc-video {
        height: 240px;
      }

      .dock {
        gap: 12px;
        padding: 8px 12px;
      }

      .code-editor-window {
        width: calc(100vw - 24px);
        height: calc(100vh - 130px);
        left: 12px;
        top: 12px;
      }

      .code-editor-toolbar { flex-wrap: wrap; }
      .code-editor-views { width: 100%; }
      .code-editor-workspace { grid-template-columns: minmax(0, 1fr); }
      .code-editor-workspace .code-editor-preview { display: none; }
      .code-editor-workspace[data-view="preview"] .code-editor-preview { display: flex; }
      .code-editor-workspace[data-view="preview"] .code-editor-source { display: none; }
      .code-editor-workspace[data-view="split"] .code-editor-source { border-right: 0; }
    }
  </style>
</head>
