    function getCalcColumnLabel(colIndex) {
      let label = '';
      let current = colIndex + 1;
      while (current > 0) {
        const remainder = (current - 1) % 26;
        label = String.fromCharCode(65 + remainder) + label;
        current = Math.floor((current - 1) / 26);
      }
      return label;
    }

    function parseCellReference(reference) {
      const match = String(reference).trim().match(/^([A-Z]+)([1-9]\d*)$/i);
      if (!match) return null;
      const letters = match[1].toUpperCase();
      let column = 0;
      for (const letter of letters) {
        column = column * 26 + (letter.charCodeAt(0) - 64);
      }
      const row = Number(match[2]) - 1;
      return { row, col: column - 1 };
    }

    function resolveCalcCellValue(row, col, stack = []) {
      const key = `${row}:${col}`;
      if (stack.includes(key)) return 0;
      const rawValue = officeCalcData[row]?.[col] ?? '';
      const trimmed = rawValue.trim();
      if (!trimmed) return 0;
      if (!trimmed.startsWith('=')) {
        const numeric = Number(trimmed.replace(',', '.'));
        return Number.isFinite(numeric) ? numeric : 0;
      }

      const expression = trimmed.slice(1).trim();
      if (!expression) return 0;

      const normalized = expression.replace(/[A-Z]+[1-9]\d*/gi, match => {
        const reference = parseCellReference(match);
        if (!reference) return match;
        return resolveCalcCellValue(reference.row, reference.col, stack.concat(key));
      });

      try {
        const value = Function(`"use strict"; return (${normalized.replace(/,/g, '.')});`)();
        return Number.isFinite(value) ? value : 0;
      } catch {
        return 0;
      }
    }

    function formatCalcDisplayValue(rawValue, row, col) {
      const trimmed = String(rawValue || '').trim();
      if (!trimmed) return '';
      if (!trimmed.startsWith('=')) {
        const numeric = Number(trimmed.replace(',', '.'));
        return Number.isFinite(numeric) ? String(numeric) : trimmed;
      }
      const result = resolveCalcCellValue(row, col);
      return Number.isFinite(result) ? String(result) : 'ERROR';
    }

