    function parseCommandArgs(str) {
      const regex = /[^\s"']+|"([^"]*)"|'([^']*)'/g;
      const args = [];
      let match;
      while ((match = regex.exec(str)) !== null) {
        if (match[1] !== undefined) args.push(match[1]);
        else if (match[2] !== undefined) args.push(match[2]);
        else args.push(match[0]);
      }
      return args;
    }

