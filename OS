    function handleHangmanGuess(value) {
      const guess = value.toLowerCase();
      if (guess === 'stop') {
        printTermLine(`Spel gestopt. Het woord was: <span class="terminal-prompt-text">${hangmanGame.word.toUpperCase()}</span>.`);
        hangmanGame = null;
        return;
      }
      if (!/^[a-z]$/.test(guess)) {
        printTermLine('Voer precies een letter in, of typ stop.', 'error');
        return;
      }
      if (hangmanGame.guesses.has(guess)) {
        printTermLine(`De letter ${guess.toUpperCase()} is al gebruikt.`, 'error');
        return;
      }

      hangmanGame.guesses.add(guess);
      if (!hangmanGame.word.includes(guess)) hangmanGame.mistakes++;
      const solved = [...hangmanGame.word].every(letter => hangmanGame.guesses.has(letter));
      if (solved || hangmanGame.mistakes >= 6) {
        renderHangman();
        printTermLine(solved
          ? '<span class="terminal-success-text">Gewonnen! Je hebt het woord geraden.</span>'
          : `Game over. Het woord was: <span class="terminal-prompt-text">${hangmanGame.word.toUpperCase()}</span>.`, solved ? 'out' : 'error');
        hangmanGame = null;
      } else {
        renderHangman();
      }
    }

