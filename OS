    function renderHangman() {
      const { word, guesses, mistakes } = hangmanGame;
      const maskedWord = [...word].map(letter => guesses.has(letter) ? letter.toUpperCase() : '_').join(' ');
      const drawing = [
        ' +---+',
        ' |   |',
        ` ${mistakes > 0 ? 'O' : ' '}   |`,
        `/${mistakes > 2 ? '|' : ' '}${mistakes > 1 ? '\\' : ' '}  |`,
        `/${mistakes > 3 ? ' ' : ''} ${mistakes > 4 ? '\\' : ' '}  |`,
        '     |',
        '====='
      ].join('\n');
      printTermLine(`${drawing}\n\nWoord: <span class="terminal-prompt-text">${maskedWord}</span>\nFoute gokken: ${mistakes}/6\nGebruikte letters: ${[...guesses].sort().join(', ') || '-'}`);
    }

    function startHangman() {
      const word = hangmanWords[Math.floor(Math.random() * hangmanWords.length)];
      hangmanGame = { word, guesses: new Set(), mistakes: 0 };
      printTermLine('<span class="terminal-success-text">Hangman gestart.</span> Raad een letter en druk op Enter. Typ <span class="terminal-prompt-text">stop</span> om te stoppen.');
      renderHangman();
