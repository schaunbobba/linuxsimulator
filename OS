    document.addEventListener('mousemove', (event) => {
      if (!activeIconDrag) return;

      const { icon, startX, startY, offsetX, offsetY } = activeIconDrag;
      const desktopRect = desktop.getBoundingClientRect();
      const hasMoved = Math.abs(event.clientX - startX) > 4 || Math.abs(event.clientY - startY) > 4;
      if (!hasMoved) return;

      const maxLeft = desktopRect.width - icon.offsetWidth - desktopGrid.padding;
      const maxTop = desktopRect.height - icon.offsetHeight - desktopGrid.padding;
      const left = Math.min(Math.max(desktopGrid.padding, event.clientX - desktopRect.left - offsetX), maxLeft);
      const top = Math.min(Math.max(desktopGrid.padding, event.clientY - desktopRect.top - offsetY), maxTop);
      icon.style.left = `${left}px`;
      icon.style.top = `${top}px`;
      icon.dataset.moved = 'true';
    });

    document.addEventListener('mouseup', () => {
      if (!activeIconDrag) return;

      const { icon, originalLeft, originalTop } = activeIconDrag;
