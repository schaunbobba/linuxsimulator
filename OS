        return `<div class="server-page"><div class="server-page-details"><strong>${escapeHtml(page.name)}</strong><span>${escapeHtml(source)}</span></div><div class="server-page-actions"><button type="button" data-server-open="${page.id}">Openen</button><button type="button" data-server-delete="${page.id}" aria-label="Verwijder ${escapeHtml(page.name)}">Verwijderen</button></div></div>`;
      }).join('');
    }

