      const maxLeft = desktopRect.width - icon.offsetWidth - desktopGrid.padding;
      const maxTop = desktopRect.height - icon.offsetHeight - desktopGrid.padding;
      const snappedLeft = Math.min(Math.max(desktopGrid.padding, Math.round((parseFloat(icon.style.left) - desktopGrid.padding) / desktopGrid.column) * desktopGrid.column + desktopGrid.padding), maxLeft);
      const snappedTop = Math.min(Math.max(desktopGrid.padding, Math.round((parseFloat(icon.style.top) - desktopGrid.padding) / desktopGrid.row) * desktopGrid.row + desktopGrid.padding), maxTop);
      const occupied = Array.from(desktop.querySelectorAll('.icon')).some(otherIcon => {
        return otherIcon !== icon && parseFloat(otherIcon.style.left) === snappedLeft && parseFloat(otherIcon.style.top) === snappedTop;
      });

      icon.style.left = occupied ? originalLeft : `${snappedLeft}px`;
      icon.style.top = occupied ? originalTop : `${snappedTop}px`;
