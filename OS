    // --- Bank app: betaal-/spaarrekening, salaris (1 maand = 60 minuten) en Box 3 ---
    const BANK_STORAGE_KEY = 'linuxSimBankState';
    const BANK_TRANSACTIONS_RESET_VERSION = 1;
    const BANK_SALARY_INTERVAL_MS = 60 * 60 * 1000; // 60 minutes = 1 month
    const BANK_SALARY_AMOUNT = 1500;
    const BANK_SALARY_SPLIT = { betaal: 0.55, spaar: 0.35, bitcoin: 0.10 };
    const BANK_BTC_EUR_PRICE = 91000;
    const BANK_BOX3_EXEMPT = 57684;
    const BANK_BOX3_BANK_RATE = 0.0144;
    const BANK_BOX3_OTHER_RATE = 0.0588;
    const BANK_BOX3_TAX_RATE = 0.36;
    const BANK_LOAN_RATES = { 12: 0.059, 24: 0.064, 36: 0.072 };

    let bankBetaalBalance = 1250;
    let bankSpaarBalance = 8400;
    let bankWalletBtc = 0;
    let bankMonthCount = 1;
    let bankNextSalaryAt = Date.now() + BANK_SALARY_INTERVAL_MS;
    let bankTransactions = [];
    let bankLoan = { principal: 0, outstanding: 0, annualRate: 0, termMonths: 0, monthlyPayment: 0 };

    function formatEuro(amount) {
      return '\u20ac ' + amount.toLocaleString('nl-NL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatCountdown(ms) {
      const totalSeconds = Math.max(0, Math.ceil(ms / 1000));
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      return [hours, minutes, seconds].map(value => String(value).padStart(2, '0')).join(':');
    }

    function getNextRealTimeSalaryAt(now = Date.now()) {
      const next = new Date(now);
      next.setMinutes(0, 0, 0);
      next.setMilliseconds(0);
      next.setTime(next.getTime() + BANK_SALARY_INTERVAL_MS);
      return next.getTime();
    }

    function loadBankState() {
      try {
        const saved = JSON.parse(localStorage.getItem(BANK_STORAGE_KEY) || 'null');
        if (!saved) return;
        bankBetaalBalance = saved.betaal;
        bankSpaarBalance = saved.spaar;
        bankWalletBtc = saved.btc;
        bankMonthCount = saved.month;
        bankNextSalaryAt = saved.nextSalaryAt;
        bankLoan = saved.loan || bankLoan;
        bankTransactions = saved.transactionsResetVersion === BANK_TRANSACTIONS_RESET_VERSION ? (saved.transactions || []) : [];
      } catch (err) {
        // negeer corrupte opgeslagen staat
      }
    }

    function persistBankState() {
      localStorage.setItem(BANK_STORAGE_KEY, JSON.stringify({
        betaal: bankBetaalBalance,
        spaar: bankSpaarBalance,
        btc: bankWalletBtc,
        month: bankMonthCount,
        nextSalaryAt: bankNextSalaryAt,
        loan: bankLoan,
        transactionsResetVersion: BANK_TRANSACTIONS_RESET_VERSION,
        transactions: bankTransactions.slice(0, 10)
      }));
    }

    function renderBankTransactions() {
      const list = document.getElementById('bank-tx-list');
      if (!list) return;
      if (!bankTransactions.length) {
        list.innerHTML = '<li><span>Geen mutaties</span></li>';
        return;
      }
      list.innerHTML = bankTransactions.map(tx => {
        const cls = tx.amount >= 0 ? 'positive' : 'negative';
        const sign = tx.amount >= 0 ? '+' : '-';
        const time = new Date(tx.at).toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' });
        return `<li><span>${escapeHtml(tx.label)}<br><small>${time}</small></span><span class="bank-tx-amount ${cls}">${sign}${formatEuro(Math.abs(tx.amount))}</span></li>`;
      }).join('');
    }

    function addBankTransaction(label, amount) {
      bankTransactions.unshift({ label, amount, at: Date.now() });
      bankTransactions = bankTransactions.slice(0, 10);
      renderBankTransactions();
    }

    function updateWalletBtcDisplay() {
      const amountEl = document.getElementById('wallet-btc-amount');
      const fiatEl = document.getElementById('wallet-btc-fiat');
      const totalEl = document.getElementById('wallet-total-value');
      const fiatValue = bankWalletBtc * BANK_BTC_EUR_PRICE;
      if (amountEl) amountEl.textContent = bankWalletBtc.toFixed(4) + ' BTC';
      if (fiatEl) fiatEl.textContent = formatEuro(fiatValue);
      if (totalEl) totalEl.textContent = formatEuro(fiatValue);
    }

    function updateBox3View() {
      const bankValue = bankBetaalBalance + bankSpaarBalance;
      const otherValue = bankWalletBtc * BANK_BTC_EUR_PRICE;
      const totalValue = bankValue + otherValue;
      const basis = Math.max(0, totalValue - BANK_BOX3_EXEMPT);
      const bankShare = totalValue > 0 ? bankValue / totalValue : 0;
      const otherShare = totalValue > 0 ? otherValue / totalValue : 0;
      const bankReturn = basis * bankShare * BANK_BOX3_BANK_RATE;
      const otherReturn = basis * otherShare * BANK_BOX3_OTHER_RATE;
      const benefit = bankReturn + otherReturn;
      const tax = benefit * BANK_BOX3_TAX_RATE;

      const setText = (id, value) => {
        const el = document.getElementById(id);
        if (el) el.textContent = formatEuro(value);
      };
      setText('box3-bank-value', bankValue);
      setText('box3-other-value', otherValue);
      setText('box3-total-value', totalValue);
      setText('box3-basis-value', basis);
      setText('box3-bank-return', bankReturn);
      setText('box3-other-return', otherReturn);
      setText('box3-benefit-value', benefit);
      setText('box3-tax-value', tax);
    }

    function renderBankBalances() {
      const betaalEl = document.getElementById('bank-betaal-balance');
      const spaarEl = document.getElementById('bank-spaar-balance');
      if (betaalEl) betaalEl.textContent = formatEuro(bankBetaalBalance);
      if (spaarEl) spaarEl.textContent = formatEuro(bankSpaarBalance);
      const outstandingEl = document.getElementById('bank-loan-outstanding');
      const rateEl = document.getElementById('bank-loan-rate');
      const paymentEl = document.getElementById('bank-loan-payment');
      const loanBalanceEl = document.getElementById('bank-lening-balance');
      if (outstandingEl) outstandingEl.textContent = formatEuro(bankLoan.outstanding);
      if (rateEl) rateEl.textContent = bankLoan.outstanding > 0 ? (bankLoan.annualRate * 100).toFixed(1) + '%' : '-';
      if (paymentEl) paymentEl.textContent = bankLoan.outstanding > 0 ? formatEuro(bankLoan.monthlyPayment) : '-';
      if (loanBalanceEl) loanBalanceEl.textContent = formatEuro(bankLoan.outstanding);
      updateWalletBtcDisplay();
      updateBox3View();
    }

    function payMonthlySalary() {
      const betaalPart = BANK_SALARY_AMOUNT * BANK_SALARY_SPLIT.betaal;
      const spaarPart = BANK_SALARY_AMOUNT * BANK_SALARY_SPLIT.spaar;
      const bitcoinPart = BANK_SALARY_AMOUNT * BANK_SALARY_SPLIT.bitcoin;

      bankBetaalBalance += betaalPart;
      bankSpaarBalance += spaarPart;
      bankWalletBtc += bitcoinPart / BANK_BTC_EUR_PRICE;

      addBankTransaction(`Salaris maand ${bankMonthCount} - Betaalrekening`, betaalPart);
      addBankTransaction(`Salaris maand ${bankMonthCount} - Spaarrekening`, spaarPart);
      addBankTransaction(`Salaris maand ${bankMonthCount} - Bitcoin Wallet`, bitcoinPart);

      bankMonthCount += 1;
      bankNextSalaryAt = getNextRealTimeSalaryAt(Date.now());
      renderBankBalances();
      persistBankState();
    }

    function calculateLoanPayment(principal, annualRate, termMonths) {
      const monthlyRate = annualRate / 12;
      return principal * monthlyRate / (1 - Math.pow(1 + monthlyRate, -termMonths));
    }

    function showLoanMessage(id, text, type) {
      const messageEl = document.getElementById(id);
      if (!messageEl) return;
      messageEl.textContent = text;
      messageEl.className = 'bank-transfer-message ' + type;
    }

    const loanApplyBtn = document.getElementById('bank-loan-apply-btn');
    if (loanApplyBtn) {
      loanApplyBtn.addEventListener('click', () => {
        const amountEl = document.getElementById('bank-loan-amount');
        const termEl = document.getElementById('bank-loan-term');
        const amount = parseFloat(amountEl.value);
        const termMonths = Number(termEl.value);
        if (!amount || amount < 500 || amount > 25000) {
          showLoanMessage('bank-loan-apply-message', 'Kies een bedrag tussen € 500 en € 25000.', 'error');
          return;
        }
        if (bankLoan.outstanding > 0) {
          showLoanMessage('bank-loan-apply-message', 'Los je huidige lening eerst volledig af.', 'error');
          return;
        }
        const annualRate = BANK_LOAN_RATES[termMonths];
        const monthlyPayment = calculateLoanPayment(amount, annualRate, termMonths);
        bankLoan = { principal: amount, outstanding: amount, annualRate, termMonths, monthlyPayment };
        bankBetaalBalance += amount;
        addBankTransaction(`Lening ${termMonths} maanden naar Betaalrekening`, amount);
        renderBankBalances();
        persistBankState();
        amountEl.value = '';
        showLoanMessage('bank-loan-apply-message', `${formatEuro(amount)} is bijgeschreven op je Betaalrekening. Termijn: ${formatEuro(monthlyPayment)} per maand.`, 'success');
      });
    }

    const loanRepayBtn = document.getElementById('bank-loan-repay-btn');
    if (loanRepayBtn) {
      loanRepayBtn.addEventListener('click', () => {
        const amountEl = document.getElementById('bank-loan-repay-amount');
        const amount = parseFloat(amountEl.value);
        if (!bankLoan.outstanding) {
          showLoanMessage('bank-loan-repay-message', 'Je hebt momenteel geen openstaande lening.', 'error');
          return;
        }
        if (!amount || amount <= 0) {
          showLoanMessage('bank-loan-repay-message', 'Vul een geldig aflossingsbedrag in.', 'error');
          return;
        }
        if (amount > bankBetaalBalance) {
          showLoanMessage('bank-loan-repay-message', 'Onvoldoende saldo op je Betaalrekening.', 'error');
          return;
        }
        const repayment = Math.min(amount, bankLoan.outstanding);
        bankBetaalBalance -= repayment;
        bankLoan.outstanding -= repayment;
        if (bankLoan.outstanding < 0.01) {
          bankLoan = { principal: 0, outstanding: 0, annualRate: 0, termMonths: 0, monthlyPayment: 0 };
        }
        addBankTransaction('Extra aflossing lening', -repayment);
        renderBankBalances();
        persistBankState();
        amountEl.value = '';
        showLoanMessage('bank-loan-repay-message', `${formatEuro(repayment)} afgelost op je lening.`, 'success');
      });
    }

    function updateBankCountdown() {
      const countdownEl = document.getElementById('bank-salary-countdown');
