    const desktop = document.querySelector('.desktop');
    const desktopGrid = { column: 108, row: 110, padding: 20 };
    let activeIconDrag = null;

    function getDesktopGridPosition(index) {
      const availableHeight = desktop.clientHeight - desktopGrid.padding * 2;
      const rows = Math.max(1, Math.floor((availableHeight - 86) / desktopGrid.row) + 1);
      return {
        left: desktopGrid.padding + Math.floor(index / rows) * desktopGrid.column,
        top: desktopGrid.padding + (index % rows) * desktopGrid.row
      };
    }

    function repositionHiddenDesktopIcons() {
      const desktopRect = desktop.getBoundingClientRect();
      const occupiedCells = new Set();
      const allDesktopIcons = desktop.querySelectorAll('.icon');

      allDesktopIcons.forEach(icon => {
        const left = parseFloat(icon.style.left);
        const top = parseFloat(icon.style.top);
        const isVisible = left >= desktopGrid.padding && top >= desktopGrid.padding && left + icon.offsetWidth <= desktopRect.width - desktopGrid.padding && top + icon.offsetHeight <= desktopRect.height - desktopGrid.padding;
        if (isVisible) occupiedCells.add(`${left}:${top}`);
      });

      allDesktopIcons.forEach((icon, index) => {
        const left = parseFloat(icon.style.left);
        const top = parseFloat(icon.style.top);
        const isVisible = left >= desktopGrid.padding && top >= desktopGrid.padding && left + icon.offsetWidth <= desktopRect.width - desktopGrid.padding && top + icon.offsetHeight <= desktopRect.height - desktopGrid.padding;
        if (isVisible) return;

        let cellIndex = index;
        let position = getDesktopGridPosition(cellIndex);
        while (occupiedCells.has(`${position.left}:${position.top}`)) {
          cellIndex += 1;
          position = getDesktopGridPosition(cellIndex);
        }
